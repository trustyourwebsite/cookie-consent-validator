{
  "name": "@trustyourwebsite/cookie-consent-validator",
  "version": "1.0.0",
  "description": "Verify that cookie consent banners actually work. Clicks \"Reject All\" and checks if tracking cookies and scripts really stop.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cookie-consent-validator": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "privacy",
    "cmp",
    "cookiebot",
    "onetrust",
    "compliance",
    "validator",
    "scanner"
  ],
  "author": "TrustYourWebsite <info@trustyourwebsite.nl>",
  "license": "MIT",
  "homepage": "https://trustyourwebsite.nl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustyourwebsite/cookie-consent-validator.git"
  },
  "bugs": {
    "url": "https://github.com/trustyourwebsite/cookie-consent-validator/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
